# Copy to .env.local and fill in. Never commit .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=
# First model to try. On free-tier quota errors (429) the app falls back automatically to
# gemini-3.5-flash-lite → gemini-3-flash-preview → gemini-3.1-flash-lite-preview (each has its own daily quota).
GEMINI_MODEL=gemini-3.5-flash
# Or set the full order yourself:
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview
# GEMINI_VISION_MODEL=gemini-3.5-flash
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ADMIN_PASSWORD=change-me
